{
  "name": "picme-gallery-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "observability": { "enabled": false },
  "vars": { "AZURE_ORIGIN": "https://REPLACE-WITH-AZURE-HOST.azurewebsites.net/" },
  "routes": [{ "pattern": "photos.picme.am", "custom_domain": true }]
}
